---
import { sitePath } from "../lib/links";
import BaseLayout from "../layouts/BaseLayout.astro";
import raw from "../data/results.json";
import summary from "../data/summary.json";
import { bestBackend, type Report } from "../lib/evidence";
const report = raw as unknown as Report | null;
const cases = report?.cases ?? [];
const passCount = cases.reduce((n, c) => n + Object.values(c.correctness).filter(v => v.passed).length, 0);
const wins = cases.filter(c => bestBackend(c)[1].median_ms < c.timings.torch_loop.median_ms).length;
const sampleCount = cases.reduce((n, c) => n + Object.values(c.timings).reduce((m, t) => m + t.samples_ms.length, 0), 0);
const chartCases = cases.filter(c => c.trace_kind === "synthetic" && c.tokens === 128 && c.top_k === 2);
const maxChart = Math.max(...chartCases.flatMap(c => Object.values(c.timings).map(t => t.median_ms)), .001);
const date = report ? new Date(report.created_at).toLocaleDateString("en", { timeZone: "America/New_York", month: "long", day: "numeric", year: "numeric" }) : "Pending";
---
<BaseLayout title="GPU evidence — MoEscope" description="Inspect raw A100 measurements, model routing captures, correctness results, and the limits of our experiment.">
  <section class="lab-shell">
    <header class="page-heading">
      <p class="eyebrow">02 / Reproducible evidence</p>
      <h1>Show the work.<br /><em>Keep the receipts.</em></h1>
      <p>Our measurements connect each workload to a trace, a configuration, and an environment. Every number below is derived from the downloadable result bundle.</p>
    </header>
    {report ? <>
      <p class="evidence-banner">MEASURED ON {report.environment.gpu} · {date} · {report.complete ? "Complete run" : "Partial run"}</p>
      <div class="metric-strip">
        <div><b>{cases.length}</b><span>GPU workloads</span></div>
        <div><b>{sampleCount.toLocaleString("en")}</b><span>timing samples</span></div>
        <div><b>{summary.event_count}</b><span>captured routing events</span></div>
        <div><b>{passCount}</b><span>backend checks passed</span></div>
      </div>
      <section class="lab-panel">
        <div class="panel-heading"><h2>Same token count. Different work.</h2><span>128 tokens · top-2 · 64 experts</span></div>
        <p class="panel-note">Synthetic controls hold M-assignment count, N, and K fixed while changing routing balance. Lower bars mean less device time for one grouped projection.</p>
        <div class="comparison-chart">
          {chartCases.map(c => <div class="comparison-group">
            <h3>{c.distribution}</h3>
            <span>{c.active_experts} active experts</span>
            {["torch_loop", "triton_m16_n64_k32", "triton_m32_n64_k32", "triton_m64_n64_k32"].map(name => { const timing = c.timings[name]; return <div class="comparison-row">
              <label>{name === "torch_loop" ? "PyTorch loop" : name.replace("triton_", "Triton ").replaceAll("_", " ")}</label>
              <div class="comparison-track"><i style={`width:${timing.median_ms / maxChart * 100}%`} class={name === "torch_loop" ? "baseline" : ""}></i></div>
              <b>{(timing.median_ms * 1000).toFixed(1)} µs</b>
            </div>; })}
          </div>)}
        </div>
      </section>
      <div class="lab-split">
        <section class="lab-panel prose-panel"><h2>What this measures</h2>
          <p>One grouped gate/up-shaped matrix projection in float16, with float32 accumulation. CUDA events time a graph containing ten invocations; each case has thirty samples after warmup.</p>
          <p>We prepare tensors and pointer tables before timing. Captured workloads preserve OLMoE’s expert counts and matrix dimensions, but replay seeded random matrix values.</p>
        </section>
        <section class="lab-panel prose-panel"><h2>What the result supports</h2>
          <p>The fastest tested Triton configuration beats the PyTorch loop in <strong>{wins} of {cases.length}</strong> cases in this run. This is an in-sample comparison, including configuration selection.</p>
          <p>It does not measure full-model inference, routing, gather/scatter, or allocation. One rented A100 and six authored prompts do not establish a universal speedup.</p>
        </section>
      </div>
      <section class="lab-panel">
        <div class="panel-heading"><h2>Inspect every case</h2><span>Wins and losses included</span></div>
        <div class="result-filters">
          <label>Provenance<select id="kind-filter"><option value="all">All workloads</option><option value="captured">Captured routing</option><option value="synthetic">Synthetic controls</option></select></label>
          <label>Search<input id="case-search" type="search" placeholder="Prompt, distribution, token count…" /></label>
          <p id="case-count" aria-live="polite">{cases.length} cases</p>
        </div>
        <div class="table-scroll"><table class="data-table results-table">
          <caption>Median and p95 latency for prepared grouped GEMMs</caption>
          <thead><tr><th>Workload</th><th>Tokens / active</th><th>PyTorch median</th><th>Best Triton median</th><th>Triton p95</th><th>Ratio¹</th><th>Config</th></tr></thead>
          <tbody>{cases.map(c => {
            const [name, timing] = bestBackend(c);
            const ratio = c.timings.torch_loop.median_ms / timing.median_ms;
            return <tr data-kind={c.trace_kind} data-search={c.id.toLowerCase()}>
              <td><a href={sitePath(`/lab/?trace=${encodeURIComponent(c.id)}`)}>{c.id}</a><small>{c.trace_kind} · N={c.intermediate_size}, K={c.hidden_size}</small></td>
              <td>{c.tokens} / {c.active_experts}</td>
              <td>{(c.timings.torch_loop.median_ms * 1000).toFixed(2)} µs</td>
              <td>{(timing.median_ms * 1000).toFixed(2)} µs</td>
              <td>{(timing.p95_ms * 1000).toFixed(2)} µs</td>
              <td class={ratio >= 1 ? "ratio-win" : "ratio-loss"}>{ratio.toFixed(2)}×</td>
              <td>{name.replace("triton_", "").replaceAll("_", " / ")}</td>
            </tr>;
          })}</tbody>
        </table></div>
        <p class="panel-note">¹ PyTorch median ÷ fastest tested Triton median. Below 1 means the PyTorch loop was faster. Selection uses these same measurements; this is not a held-out routing policy.</p>
      </section>
      <section class="lab-panel prose-panel">
        <h2>Reproduce, inspect, challenge.</h2>
        <p>{report.environment.gpu} · {report.environment.num_sms} SMs · PyTorch {report.environment.torch} · Triton {report.environment.triton} · CUDA {report.environment.cuda}.</p>
        <p>We also ran {report.edge_checks.length} checks for partial M/N/K tiles and empty groups. The capture manifest records model revision, prompt text, token IDs, layer, phase, and observed expert input counts.</p>
        <div class="hero-links"><a class="text-link" href={sitePath("/data/gpu-results.json")} download>Raw measurements ↓</a><a class="text-link" href={sitePath("/data/capture-manifest.json")} download>Capture manifest ↓</a><a class="text-link" href={sitePath("/data/profile.json")} download>GPU profile ↓</a><a class="text-link" href="https://github.com/KingReaper6940/MoE-Scope/tree/main/experiments/gpu">Reproduction scripts ↗</a></div>
      </section>
    </> : <section class="lab-panel prose-panel"><h2>Measurement run pending</h2><p>The GPU harness is implemented, but this checkout does not yet contain a completed hardware run. We will populate this page from raw artifacts after the tests finish.</p><a class="text-link" href={sitePath("/lab/")}>Explore the validated synthetic fixtures →</a></section>}
  </section>
</BaseLayout>
<script>
  const kind = document.querySelector<HTMLSelectElement>("#kind-filter");
  const search = document.querySelector<HTMLInputElement>("#case-search");
  function filter() {
    let visible = 0;
    document.querySelectorAll<HTMLTableRowElement>("tr[data-kind]").forEach(row => {
      row.hidden = !(kind!.value === "all" || row.dataset.kind === kind!.value) || !row.dataset.search!.includes(search!.value.toLowerCase().trim());
      if (!row.hidden) visible++;
    });
    document.querySelector("#case-count")!.textContent = `${visible} cases`;
  }
  kind?.addEventListener("change", filter);
  search?.addEventListener("input", filter);
</script>
